---
import Layout from "../layouts/Layout.astro";
import FilmCard from "../components/FilmCard.astro";
import { supabase } from "../lib/supabase";

// Haal query parameters op
const searchParams = Astro.url.searchParams;
const format = searchParams.get("format") || "";
const brand = searchParams.get("brand") || "";
const iso = searchParams.get("iso") || "";
const country = searchParams.get("country") || "";

// Haal producten op
let query = supabase.from("products").select(`
    *,
    brand:brands(name, logo_url),
    product_urls(
      prices(price, created_at),
      store:stores(name, country, website),
      url
    )
  `);
if (format) query = query.eq("format", format);
if (brand) query = query.eq("brand_id", brand);
if (iso) query = query.eq("iso", parseInt(iso));
// Land filteren gebeurt later op de prijzen
const { data: products, error } = await query.order("name");

// Haal unieke merken op
const { data: brands, error: brandsError } = await supabase
  .from("brands")
  .select("id, name")
  .order("name");

console.log("Brands data:", brands);
console.log("Brands error:", brandsError);

const brandOptions = [
  { value: "", label: "Alle merken" },
  ...(brands?.map((b) => ({
    value: b.id,
    label: b.name.charAt(0).toUpperCase() + b.name.slice(1),
  })) || []),
];

console.log("Brand options:", brandOptions);

const productsWithPrices =
  (products as any[] | null)?.map((product) => {
    const pricesWithStores =
      product.product_urls?.map((pu: any) => ({
        price: pu.prices?.[0]?.price,
        store: pu.store,
        url: pu.url,
      })) || [];
    // Filter prijzen op land als er een land is geselecteerd
    const filteredPrices = country
      ? pricesWithStores.filter((p: any) => p.store?.country === country)
      : pricesWithStores;
    const sorted = filteredPrices
      .filter((p: any) => p.price !== undefined && p.price !== null)
      .sort((a: any, b: any) => (a.price as number) - (b.price as number));
    const lowestPrice = sorted.length > 0 ? sorted[0].price : null;
    const cheapestStores =
      sorted.length > 0
        ? sorted
            .filter((p: any) => p.price === lowestPrice)
            .map((p: any) => ({ name: p.store?.name || "", url: p.url }))
        : [];
    return {
      id: product.id,
      name: product.name,
      brand: product.brand?.name,
      format: product.format,
      iso: product.iso,
      image_url: product.image_url ?? undefined,
      lowestPrice,
      stores: cheapestStores,
    };
  }) || [];

const formatOptions = [
  { value: "", label: "Alle formaten" },
  { value: "35mm", label: "35mm" },
  { value: "120", label: "120" },
  { value: "sheet", label: "Sheet film" },
];
const isoOptions = [
  { value: "", label: "Alle ISO's" },
  { value: "50", label: "50" },
  { value: "100", label: "100" },
  { value: "200", label: "200" },
  { value: "400", label: "400" },
  { value: "800", label: "800" },
  { value: "1600", label: "1600" },
  { value: "3200", label: "3200" },
];
const countryOptions = [
  { value: "", label: "Alle landen" },
  { value: "nl", label: "Nederland" },
  { value: "be", label: "België" },
  { value: "de", label: "Duitsland" },
];
---

<Layout title="FilmFinder - Vind de goedkoopste analoge film">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-center mb-8">FilmFinder</h1>
    <p class="text-center text-lg mb-8">
      Vind de goedkoopste analoge film voor je camera
    </p>
    <div class="max-w-6xl mx-auto">
      <form
        method="get"
        class="bg-card p-6 rounded-lg shadow mb-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
      >
        <div>
          <label for="format" class="block text-sm font-medium mb-2"
            >Formaat</label
          >
          <select
            id="format"
            name="format"
            class="w-full px-4 py-2 rounded-md border border-input bg-background"
          >
            {
              formatOptions.map((opt) => (
                <option value={opt.value} selected={format === opt.value}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="brand" class="block text-sm font-medium mb-2">Merk</label>
          <select
            id="brand"
            name="brand"
            class="w-full px-4 py-2 rounded-md border border-input bg-background"
          >
            {
              brandOptions.map((opt) => (
                <option value={opt.value} selected={brand === opt.value}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="iso" class="block text-sm font-medium mb-2">ISO</label>
          <select
            id="iso"
            name="iso"
            class="w-full px-4 py-2 rounded-md border border-input bg-background"
          >
            {
              isoOptions.map((opt) => (
                <option value={opt.value} selected={iso === opt.value}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="country" class="block text-sm font-medium mb-2"
            >Land</label
          >
          <select
            id="country"
            name="country"
            class="w-full px-4 py-2 rounded-md border border-input bg-background"
          >
            {
              countryOptions.map((opt) => (
                <option value={opt.value} selected={country === opt.value}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
        <div class="md:col-span-2 lg:col-span-4 flex gap-4 mt-4">
          <button
            type="submit"
            class="bg-primary text-primary-foreground px-4 py-2 rounded-md hover:opacity-90 transition"
            >Filteren</button
          >
          <a
            href="/"
            class="px-4 py-2 rounded-md border border-input bg-background hover:bg-muted transition"
            >Reset</a
          >
        </div>
      </form>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          productsWithPrices.map((product) => (
            <FilmCard
              name={product.name}
              brand={product.brand}
              format={product.format}
              iso={product.iso}
              image_url={product.image_url ?? undefined}
              lowestPrice={product.lowestPrice}
              stores={JSON.stringify(product.stores ?? [])}
              href={`/products/${product.id}`}
            />
          ))
        }
      </div>
    </div>
  </main>
</Layout>
